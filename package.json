{
  "name": "@powderworks/docs",
  "version": "0.4.0",
  "description": "Turn a tree of markdown into a tree of indexes. One small script to copy a code block, another to open the index on a narrow screen, a third to search.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PowderworksCode/docs.git"
  },
  "homepage": "https://github.com/PowderworksCode/docs#readme",
  "type": "module",
  "bin": {
    "powderworks-docs": "src/cli.mjs"
  },
  "files": [
    "src",
    "theme.css",
    "tools",
    "powderworks.toml",
    "fonts",
    "assets"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src",
    "format": "biome format src",
    "test": "bun run selfcheck && bun run selfcheck:frontmatter",
    "selfcheck": "node src/cli.mjs build example/content --out /tmp/pw-docs-selfcheck --site example --static example/public",
    "selfcheck:frontmatter": "node tools/check-frontmatter.mjs /tmp/pw-docs-selfcheck"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "marked": "^16.4.1",
    "pagefind": "^1.5.2",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
